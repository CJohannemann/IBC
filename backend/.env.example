# ---------------------------------------------------------------------------
# Break-glass admin credentials (OPTIONAL)
#
# Only used when no matching row exists in the users table. Set these to
# bootstrap the very first account or to recover from a lockout, then UNSET
# them - while they are set, a shared password grants full admin access and
# nobody can tell who used it.
#
# Create real accounts instead:
#   node backend/scripts/manage-users.js add <username> --role admin
# ---------------------------------------------------------------------------
# ADMIN_USER=changeme
# ADMIN_PASS=changeme

# Marks session cookies Secure and enables production warnings. Set on the VPS.
NODE_ENV=production

# Comma-separated origins allowed to send credentialed requests. Required in
# production: cookie auth cannot use a wildcard origin.
CORS_ORIGIN=https://your-domain.example

# Which proxies to trust for the client IP. Behind nginx on the same host,
# 'loopback' is correct - without it every visitor shares one rate-limit bucket.
TRUST_PROXY=loopback

# How long a login lasts before it must be repeated.
SESSION_TTL_DAYS=14

# Override the database location if the VPS layout differs from the repo.
# DB_PATH=/srv/ibc/database/baseball.db
